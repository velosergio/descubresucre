# =============================================================================
# App (copia a `.env` para desarrollo/producción)
# =============================================================================

# Base de datos (MySQL/MariaDB). Prisma exige el esquema mysql:// (no mariadb://) — si no, P1013.
DATABASE_URL="mysql://root:@localhost:3306/sucre_vivo"

# Auth.js / NextAuth — genera uno seguro: `npx auth secret` o `openssl rand -base64 32`
AUTH_SECRET=""

# URL pública de la app (producción). En local suele inferirse.
# AUTH_URL="http://localhost:3000"

# Chat n8n (async): secreto compartido entre Next y el workflow n8n (cabecera X-N8N-Secret o campo "secret" en el POST al callback).
N8N_CALLBACK_SECRET=""

# Origen público (callbacks desde n8n hacia /api/chat/n8n-callback). Ej.: https://tudominio.com
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# OAuth Google (opcional). En Google Cloud Console añade redirect:
# {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="TU_API_KEY"

# Primer usuario administrador (después de migraciones y seed de roles):
# npm run admin:create
# (te pedirá correo, contraseña y confirmación en la terminal)

# Registro público en /register: rol "editor" y estado PENDING hasta aprobación en /admin/users.
# Tras aprobar, el usuario puede entrar a /admin. Rechazados ven /cuenta/rechazada.
# Google OAuth: mismo callback /api/auth/callback/google (nuevas cuentas también quedan PENDING).

# =============================================================================
# Tests (copia la sección a `.env.test` — nunca uses la misma DB que DATABASE_URL)
# Scripts: test:integration, test:e2e, test:coverage, test:db:prepare
# =============================================================================

TEST_DATABASE_URL="mysql://root:@localhost:3306/sucre_vivo_test"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
AUTH_SECRET="test-auth-secret"
N8N_CALLBACK_SECRET="test-n8n-secret"

// Auth.js Prisma adapter + RBAC (MySQL)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserAccountStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String              @id @default(cuid())
  name          String?
  email         String              @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accountStatus UserAccountStatus   @default(APPROVED)
  accounts      Account[]
  sessions      Session[]
  roles         Role[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
}

enum ChatJobStatus {
  PENDING
  DONE
  ERROR
}

/// Fila única: id fijo "singleton". URL del webhook n8n solo en servidor.
model ChatbotSettings {
  id            String   @id @default("singleton")
  n8nWebhookUrl String?  @db.Text
  updatedAt     DateTime @updatedAt
}

model ChatJob {
  id             String        @id @default(cuid())
  status         ChatJobStatus @default(PENDING)
  assistantReply String?       @db.Text
  errorMessage   String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum HeroMode {
  IMAGE_DEFAULT
  IMAGE_CUSTOM
  VIDEO
  CAROUSEL
}

enum HeroVideoSource {
  UPLOAD
  EXTERNAL_URL
}

/// Fila única: id fijo "singleton". Apariencia del hero en la home.
model HeroAppearanceSettings {
  id              String           @id @default("singleton")
  heroMode        HeroMode         @default(IMAGE_DEFAULT)
  heroImageUrl    String?          @db.VarChar(2048)
  heroVideoUrl    String?          @db.VarChar(2048)
  heroVideoSource HeroVideoSource?
  carouselSlides  Json?
  updatedAt       DateTime         @updatedAt
}

enum GalleryAssetKind {
  IMAGE
  VIDEO
}

/// Medios subidos desde la galería administrativa (reutilizables en el banner).
model GalleryAsset {
  id           String           @id @default(cuid())
  kind         GalleryAssetKind
  publicUrl    String           @unique @db.VarChar(768)
  mimeType     String?          @db.VarChar(128)
  sizeBytes    Int?
  originalName String?          @db.VarChar(512)
  createdAt    DateTime         @default(now())

  @@index([kind])
  @@index([createdAt])
}

enum ImperdiblesDisplayMode {
  GRID_THREE
  CAROUSEL
}

enum ImperdiblesItemOrder {
  MANUAL
  RANDOM
}

/// Fila única: id fijo "singleton". Presentación de la sección Destinos imperdibles en la home.
model ImperdiblesSectionSettings {
  id                   String                 @id @default("singleton")
  displayMode          ImperdiblesDisplayMode @default(GRID_THREE)
  itemOrder            ImperdiblesItemOrder   @default(MANUAL)
  headingTitle         String?                @db.VarChar(200)
  headingSubtitle      String?                @db.VarChar(500)
  carouselIntervalMs   Int                    @default(5000)
  updatedAt            DateTime               @updatedAt
}

enum BiodiversityKind {
  FAUNA
  FLORA
  ECOSYSTEM
}

/// Micrositio temático Sucre Natural (catálogo cerrado de 7 ids).
model SucreNaturalHub {
  id            String                    @id @db.VarChar(32)
  title         String                    @db.VarChar(200)
  tagline       String?                   @db.VarChar(500)
  introMarkdown String?                   @db.Text
  coverImageUrl String?                   @db.VarChar(2048)
  sortOrder     Int
  updatedAt     DateTime                  @updatedAt
  destinations  ImperdibleDestinationHub[]
}

/// Destino destacado en la home y página de detalle (ficha Sucre Natural opcional).
model ImperdibleDestination {
  id             String   @id @default(cuid())
  slug           String   @unique @db.VarChar(160)
  title          String   @db.VarChar(200)
  subtitle       String   @db.VarChar(500)
  cardImageUrl   String?  @db.VarChar(2048)
  bodyMarkdown   String   @db.Text
  mapLat         Decimal? @db.Decimal(10, 7)
  mapLng         Decimal? @db.Decimal(10, 7)
  mapZoom        Int      @default(14)
  published      Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  municipality           String? @db.VarChar(200)
  region                 String? @db.VarChar(200)
  locationLabel          String? @db.VarChar(300)
  ecosystems             String? @db.VarChar(500)
  approach               String? @db.VarChar(500)
  specialWhy             String? @db.Text
  howToArrive            String? @db.Text
  climate                String? @db.VarChar(300)
  recommendedTime        String? @db.VarChar(300)
  audience               String? @db.VarChar(300)
  mapNote                String? @db.VarChar(500)
  liveActivities         Json?
  responsibleTips        Json?
  biodiversityChipLabels Json?
  showOnHome             Boolean @default(false)
  seedManaged            Boolean @default(false)

  hubs               ImperdibleDestinationHub[]
  galleryItems       ImperdibleGalleryItem[]
  biodiversity       BiodiversityOnDestination[]
  experiences        ExperienceOnDestination[]
  sources            DestinationSource[]
  queHacerCategories QueHacerDestinationOnCategory[]
  queHacerActivities QueHacerActivityOnDestination[]

  @@index([published, sortOrder])
  @@index([published, showOnHome, sortOrder])
  @@index([published, municipality])
}

model ImperdibleDestinationHub {
  destinationId String
  hubId         String
  destination   ImperdibleDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  hub           SucreNaturalHub       @relation(fields: [hubId], references: [id], onDelete: Restrict)

  @@id([destinationId, hubId])
  @@index([hubId])
}

model ImperdibleGalleryItem {
  id            String                @id @default(cuid())
  destinationId String
  publicUrl     String                @db.VarChar(2048)
  sortOrder     Int                   @default(0)
  alt           String?               @db.VarChar(300)
  destination   ImperdibleDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId, sortOrder])
}

model BiodiversityEntry {
  id             String                      @id @default(cuid())
  slug           String                      @unique @db.VarChar(160)
  kind           BiodiversityKind
  groupKey       String                      @db.VarChar(80)
  commonName     String                      @db.VarChar(200)
  scientificName String?                     @db.VarChar(200)
  summary        String                      @db.Text
  whereFound     String?                     @db.Text
  imageUrl       String?                     @db.VarChar(2048)
  published      Boolean                     @default(true)
  sortOrder      Int                         @default(0)
  seedManaged    Boolean                     @default(false)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  destinations   BiodiversityOnDestination[]

  @@index([published, kind, sortOrder])
}

model BiodiversityOnDestination {
  destinationId String
  entryId       String
  destination   ImperdibleDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  entry         BiodiversityEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([destinationId, entryId])
  @@index([entryId])
}

model NatureExperience {
  id              String                    @id @default(cuid())
  slug            String                    @unique @db.VarChar(160)
  title           String                    @db.VarChar(200)
  tagline         String?                   @db.VarChar(500)
  whereText       String?                   @db.Text
  whatYouDo       Json?
  specialWhy      String?                   @db.Text
  recommendations Json?
  imageUrl        String?                   @db.VarChar(2048)
  published       Boolean                   @default(true)
  sortOrder       Int                       @default(0)
  seedManaged     Boolean                   @default(false)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  destinations    ExperienceOnDestination[]

  @@index([published, sortOrder])
}

model ExperienceOnDestination {
  destinationId String
  experienceId  String
  destination   ImperdibleDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  experience    NatureExperience      @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([destinationId, experienceId])
  @@index([experienceId])
}

model ContentSource {
  id           String              @id @default(cuid())
  slug         String              @unique @db.VarChar(80)
  name         String              @db.VarChar(200)
  url          String?             @db.VarChar(2048)
  note         String?             @db.VarChar(500)
  destinations DestinationSource[]
}

model DestinationSource {
  destinationId String
  sourceId      String
  destination   ImperdibleDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  source        ContentSource         @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([destinationId, sourceId])
  @@index([sourceId])
}

/// Categoría de «Qué hacer en Sucre» (taxonomía M-N con actividades y destinos).
model QueHacerCategory {
  id           String                           @id @default(cuid())
  slug         String                           @unique @db.VarChar(160)
  name         String                           @db.VarChar(120)
  description  String?                          @db.VarChar(500)
  sortOrder    Int                              @default(0)
  seedManaged  Boolean                          @default(false)
  createdAt    DateTime                         @default(now())
  updatedAt    DateTime                         @updatedAt
  activities   QueHacerActivityOnCategory[]
  destinations QueHacerDestinationOnCategory[]

  @@index([sortOrder])
}

enum QueHacerListingMode {
  DESTINATIONS
  BIODIVERSITY
  EXPERIENCES
}

/// Actividad pública de la sección «Qué hacer en Sucre» (tema / ex-hub).
model QueHacerActivity {
  id            String              @id @default(cuid())
  slug          String              @unique @db.VarChar(160)
  title         String              @db.VarChar(120)
  description   String              @db.Text
  tagline       String?             @db.VarChar(500)
  introMarkdown String?             @db.Text
  iconKey       String              @db.VarChar(64)
  accentHsl     String?             @db.VarChar(64)
  listingMode   QueHacerListingMode @default(DESTINATIONS)
  published     Boolean             @default(false)
  sortOrder     Int                 @default(0)
  seedManaged   Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  categories    QueHacerActivityOnCategory[]
  destinations  QueHacerActivityOnDestination[]
  photos        QueHacerActivityPhoto[]

  @@index([published, sortOrder])
}

model QueHacerActivityPhoto {
  id         String           @id @default(cuid())
  activityId String
  publicUrl  String           @db.VarChar(2048)
  sortOrder  Int              @default(0)
  alt        String?          @db.VarChar(300)
  isCover    Boolean          @default(false)
  activity   QueHacerActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, sortOrder])
}

model QueHacerActivityOnCategory {
  activityId String
  categoryId String
  activity   QueHacerActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  category   QueHacerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([activityId, categoryId])
  @@index([categoryId])
}

model QueHacerDestinationOnCategory {
  destinationId String
  categoryId    String
  destination   ImperdibleDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  category      QueHacerCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([destinationId, categoryId])
  @@index([categoryId])
}

model QueHacerActivityOnDestination {
  activityId    String
  destinationId String
  sortOrder     Int                   @default(0)
  activity      QueHacerActivity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  destination   ImperdibleDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([activityId, destinationId])
  @@index([destinationId])
}

{
  "name": "sucre-vivo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "preview": "next start",
    "test:watch": "vitest",
    "test:unit": "vitest run src/test/unit src/test/example.test.ts src/lib",
    "test:integration": "npm run test:db:prepare && node --env-file=.env.test ./node_modules/vitest/vitest.mjs run src/test/integration",
    "test:component": "vitest run src/test/components",
    "test:coverage": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run --coverage",
    "test:db:prepare": "node --env-file=.env.test scripts/prepare-test-db.mjs",
    "test:e2e": "node --env-file=.env.test ./node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "node --env-file=.env.test ./node_modules/@playwright/test/cli.js test --ui",
    "test:ci": "biome check . && npm run test:unit && npm run test:integration && npm run test:component && npm run test:e2e",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "admin:create": "node scripts/create-admin.mjs",
    "setup": "npm install && npm run db:generate",
    "doctor": "npx react-doctor@latest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },

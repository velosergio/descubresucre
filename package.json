    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "dotenv": "^18.0.6",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prisma": "^7.10.0",
    "prompts": "^2.4.2",
    "tailwindcss": "^4.3.3",
